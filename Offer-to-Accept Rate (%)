-- Offer Acceptance Rate (%):
-- Calculation: (Offers accepted / Total offers extended)
-- Why it's fair: This tracks the recruiter’s "closing" skills and how well they managed candidate expectations regarding salary and benefits.

-- EMPLOYEE.DAYFORCE.HRA_TA_REQUISITIONS
-- EMPLOYEE.DAYFORCE.HRA_TA_CANDIDATE_HISTORY
-- 1015 - Spclst-Consumer Direct Sales
-- 2771 - Elite Direct Sls Spclst-Kinetc
-- 3020 - Performance Spclst-Cons Direct

-- Results grouped by recruiter

Select --req.requisition_id as "Req ID",
       req.job_id as "Job ID",
       req.job_title as "Job Title",
       req.recruiter_name as "Recruiter",
       --"NEW_DT" as "Month",
       sum("NEW_CT") as "Total Candidates",
       sum("OFS_CT") as "Offers Sent",
       sum("ACC_CT") as "Offers Accepted",
       cast(((sum("ACC_CT") / sum("OFS_CT"))*100) AS NUMERIC(10, 2))||'%' as "Offer-to-Accept Rate (%)"

From EMPLOYEE.DAYFORCE.HRA_TA_REQUISITIONS req,

      (Select req_n.requisition_id as "NEW_EQ",
       --left(can_n.submission_date,7) as "NEW_DT",
       count(can_n.SUBMISSION_STATUS) as "NEW_CT"
       From EMPLOYEE.DAYFORCE.HRA_TA_REQUISITIONS req_n,
       EMPLOYEE.DAYFORCE.HRA_TA_CANDIDATE_HISTORY can_n
       Where replace(can_n.req_id,',','') = req_n.requisition_id
       and can_n.submission_date >= '2025-10-01'
       and can_n.SUBMISSION_STATUS = 'New'
       group by req_n.requisition_id--, left(can_n.submission_date,7)
       order by req_n.requisition_id) a,
       
      (Select req_m.requisition_id as "OFS_EQ",
       --left(can_m.submission_date,7) as "OFS_DT",
       count(can_m.SUBMISSION_STATUS) as "OFS_CT"
       From EMPLOYEE.DAYFORCE.HRA_TA_REQUISITIONS req_m,
       EMPLOYEE.DAYFORCE.HRA_TA_CANDIDATE_HISTORY can_m
       Where replace(can_m.req_id,',','') = req_m.requisition_id
       and can_m.submission_date >= '2025-10-01'
       and can_m.SUBMISSION_STATUS = 'Offer Sent'
       group by req_m.requisition_id--, left(can_m.submission_date,7)
       order by req_m.requisition_id) b ,

       (Select req_i.requisition_id as "ACC_EQ",
       --left(can_i.submission_date,7) as "ACC_DT",
       count(can_i.SUBMISSION_STATUS) as "ACC_CT"
       From EMPLOYEE.DAYFORCE.HRA_TA_REQUISITIONS req_i,
       EMPLOYEE.DAYFORCE.HRA_TA_CANDIDATE_HISTORY can_i
       Where replace(can_i.req_id,',','') = req_i.requisition_id
       and can_i.submission_date >= '2025-10-01'
       and can_i.SUBMISSION_STATUS = 'Offer Accepted'
       group by req_i.requisition_id--, left(can_i.submission_date,7)
       order by req_i.requisition_id) c 
       
Where req.requisition_id = "NEW_EQ" (+)
and req.requisition_id = "OFS_EQ" (+)
and req.requisition_id = "ACC_EQ" (+)
and req.job_id in ('1015','2771','3020')
and "NEW_CT" > 0
--and req.req_status in ('Open','Pending','On Hold')
group by req.job_id, req.job_title, req.recruiter_name
